# ==============================================================
# ECOLOOP DEPLOYMENT ENVIRONMENT CONFIGURATION
# ==============================================================

# --------------------------------------------------------------
# 1. NETLIFY (FRONTEND ENVIRONMENT VARIABLES)
# Set these in: Netlify Dashboard -> Site Configuration -> Environment Variables
# --------------------------------------------------------------
# URL of your Render backend service (do not include trailing slash)
NEXT_PUBLIC_API_URL=https://ecoloop-backend.onrender.com

# (Optional: If you want to enable Google Gemini directly from frontend serverless)
# GEMINI_API_KEY=your_gemini_api_key_here


# --------------------------------------------------------------
# 2. RENDER (BACKEND ENVIRONMENT VARIABLES)
# Set these in: Render Dashboard -> Web Service -> Environment
# --------------------------------------------------------------
PORT=10000

# MongoDB Atlas connection string
MONGODB_URI=mongodb+srv://shindedhananjay201906_db_user:<password>@cluster0.8nxoklv.mongodb.net/?appName=Cluster0

# Google Gemini Flash API Key (for EcoBot chatbot and AI Waste Scanner vision)
GEMINI_API_KEY=your_gemini_api_key_here

# Allowed CORS origins (use * for all, or your Netlify domain)
# Example: https://ecoloop-pune.netlify.app
CORS_ORIGIN=*
